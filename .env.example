# Server binding
HOST=127.0.0.1
PORT=3456

# Client gateway bearer token(s), comma-separated
GATEWAY_TOKEN=sk-aq-change-me

# Web Console (/dashboard)
ENABLE_DASHBOARD=true
DASHBOARD_PATH=/dashboard
ADMIN_PASSWORD=change-this-admin-password

# Upstream AWS Quick credentials (comma-separated)
# Use `local-outpost` to auto-refresh from local signed-in Amazon Quick.app,
# or import a raw `id_token` / `wsHost|id_token`.
QUICK_TOKENS=local-outpost

# Privacy defaults (native INCOGNITO=true leaves zero cloud history; keep AUTO_DELETE_SESSION=false to avoid frequent delete RPCs)
INCOGNITO=true
AUTO_DELETE_SESSION=false
# Override desktop client appVersion header if AWS enforces a minimum version upgrade
# AWS_QUICK_APP_VERSION=1.2.4660

# Emit actual routed AWS Quick model in thinking block (`reasoning_content` / `thinking`)
SHOW_ROUTED_MODEL_IN_THINKING=true
# Set to `true` only if a legacy streaming client cannot handle a trailing thinking chunk after text
SUPPRESS_LATE_ROUTED_THINKING_IN_STREAM=false
# Enable AWS Quick native web search (default true)
WEB_SEARCH_ENABLED=true

# Local headless outpost settings (macOS)
QUICKWORK_OUTPOST_PORT=18780
# QUICKWORK_AGENT_PATH=/Applications/Amazon Quick.app/Contents/Resources/agent/quickwork-agent

# Optional outbound proxy (global default; per-credential proxies can be set in Web Console)
# HTTPS_PROXY=http://127.0.0.1:7891
# HTTP_PROXY=http://127.0.0.1:7891

# Optional GitHub Releases update notification in Web Console (e.g. your-org/aws-quick2api)
# UPDATE_CHECK_REPO=
# Oversized context gateway protection (>850K tokens auto-compaction; set 0 to disable)
# AUTO_COMPACT_OVERFLOW_TOKENS=850000
# AUTO_COMPACT_SUMMARY=true
# Warm incremental session cache (when INCOGNITO=false)
# WARM_SESSION_TTL_MS=1800000
# MAX_WARM_SESSIONS=256

# Bounded inference admission (20 accounts: begin at 2 per account, 20 globally)
GLOBAL_MAX_CONCURRENT=20
MAX_QUEUED_REQUESTS=200
QUEUE_WAIT_TIMEOUT_MS=30000
ACCOUNT_MAX_CONCURRENT=2
# Per-account overrides are persisted by the dashboard, keyed by stable slot ID.
# KEY_CONCURRENCY_LIMITS={}
# KEY_WEIGHTS={}
# Advanced requires a verified upstream entitlement; hidden by default.
ENABLE_ADVANCED_MODEL=false

# OAuth images use original-byte native attachments by default (10 MiB/image).
NATIVE_IMAGE_UPLOAD=true
